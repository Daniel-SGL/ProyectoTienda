<body>
    <?php if(isset($_SESSION['user'])): ?>
        <header>
            <h2>¡Hola, <?= htmlspecialchars($_SESSION['user']->getName()) ?>!</h2>
            <a href="index.php?logout" class="logout">Cerrar sesion</a>
            <a href="index.php?cart" class="cart">Ver carrito</a>
        </header>

        <h3>Catalogo de Productos</h3>

        <?php if(empty($products)) : ?>
            <p>Aun no hay productos para mostrar</p>
        <?php else : ?>
            <?php foreach ($products as $product): ?>
                <div>
                    <h4><?= htmlspecialchars($product->getName()); ?></h4>
                    <p><?= htmlspecialchars($product->getDescription()); ?></p>
                    <p class="precio"><?= htmlspecialchars($product->getPrice()) . "€"; ?>
                    <form action="index.php" method="POST">
                        <input type="hidden" name="idProducto" value="<?= $product->getId(); ?>">
                        <button type="submit" name="add_to_cart">Añadir al Carrito</button>
                    </form>
                </div>
            <?php endforeach; ?>
        <?php endif; ?>

    <?php else: ?>
        <div class="card">
            <h1>Tienda Online</h1>
            <p>Por favor, selecciona una opción para continuar.</p>
            <a href="index.php?login" class="btn btn-login">Iniciar Sesión</a>
            <a href="index.php?register" class="btn btn-register">Crear una Cuenta</a>
        </div>

    <?php endif; ?>
